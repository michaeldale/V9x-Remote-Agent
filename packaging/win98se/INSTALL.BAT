@ECHO OFF
IF NOT EXIST V9XAGNT.EXE GOTO MISSING
IF NOT EXIST V9XSHOT.EXE GOTO MISSING
IF NOT EXIST AGENT.INI GOTO MISSING
IF NOT EXIST INSTALL.REG GOTO MISSING
IF NOT EXIST REMOVE.REG GOTO MISSING
IF NOT EXIST UPDATE.REG GOTO MISSING
IF NOT EXIST UPDATE.BAT GOTO MISSING
IF NOT EXIST UNINSTALL.BAT GOTO MISSING
IF NOT EXIST C:\V9XREMOTE MD C:\V9XREMOTE
IF NOT EXIST C:\V9XREMOTE GOTO FAILED
IF EXIST C:\V9XREMOTE\AGENT.INI GOTO CONFIGOK
COPY /Y AGENT.INI C:\V9XREMOTE\AGENT.INI
IF ERRORLEVEL 1 GOTO FAILED
:CONFIGOK
COPY /Y INSTALL.REG C:\V9XREMOTE\INSTALL.REG
IF ERRORLEVEL 1 GOTO FAILED
COPY /Y REMOVE.REG C:\V9XREMOTE\REMOVE.REG
IF ERRORLEVEL 1 GOTO FAILED
COPY /Y UPDATE.REG C:\V9XREMOTE\UPDATE.REG
IF ERRORLEVEL 1 GOTO FAILED
COPY /Y UPDATE.BAT C:\V9XREMOTE\UPDATE.BAT
IF ERRORLEVEL 1 GOTO FAILED
COPY /Y UNINSTALL.BAT C:\V9XREMOTE\UNINSTALL.BAT
IF ERRORLEVEL 1 GOTO FAILED
IF EXIST C:\V9XREMOTE\V9XAGNT.EXE GOTO UPDATE
COPY /Y V9XSHOT.EXE C:\V9XREMOTE\V9XSHOT.EXE
IF ERRORLEVEL 1 GOTO FRESHFAILED
COPY /Y V9XAGNT.EXE C:\V9XREMOTE\V9XAGNT.EXE
IF ERRORLEVEL 1 GOTO FRESHFAILED
ATTRIB -R C:\V9XREMOTE\*.*
REGEDIT /S C:\V9XREMOTE\INSTALL.REG
ECHO V9x Remote Agent installed. Reboot Windows to start it.
GOTO END
:UPDATE
IF EXIST C:\V9XREMOTE\V9XNEW.EXE DEL C:\V9XREMOTE\V9XNEW.EXE
IF EXIST C:\V9XREMOTE\V9XSNEW.EXE DEL C:\V9XREMOTE\V9XSNEW.EXE
COPY /Y V9XSHOT.EXE C:\V9XREMOTE\V9XSNEW.EXE
IF ERRORLEVEL 1 GOTO STAGEFAILED
COPY /Y V9XAGNT.EXE C:\V9XREMOTE\V9XNEW.EXE
IF ERRORLEVEL 1 GOTO STAGEFAILED
ATTRIB -R C:\V9XREMOTE\*.*
REGEDIT /S C:\V9XREMOTE\UPDATE.REG
ECHO V9x Remote Agent update staged. Reboot Windows to apply it.
GOTO END
:FRESHFAILED
IF EXIST C:\V9XREMOTE\V9XAGNT.EXE DEL C:\V9XREMOTE\V9XAGNT.EXE
IF EXIST C:\V9XREMOTE\V9XSHOT.EXE DEL C:\V9XREMOTE\V9XSHOT.EXE
GOTO FAILED
:STAGEFAILED
IF EXIST C:\V9XREMOTE\V9XNEW.EXE DEL C:\V9XREMOTE\V9XNEW.EXE
IF EXIST C:\V9XREMOTE\V9XSNEW.EXE DEL C:\V9XREMOTE\V9XSNEW.EXE
GOTO FAILED
:MISSING
ECHO ERROR: The install package is incomplete. V9XAGNT.EXE and V9XSHOT.EXE are required.
GOTO END
:FAILED
ECHO ERROR: V9x Remote Agent files could not be copied. No binary update was left staged.
:END
